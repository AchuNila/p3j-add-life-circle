# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional P3J Add Life Circle Integration Configuration
# Leave blank until official production values are supplied.
VITE_WHATSAPP_NUMBER=""
VITE_CONTACT_EMAIL=""
VITE_WHITE_PAPER_URL=""
VITE_PRESENTATION_DECK_URL=""
VITE_YOUTUBE_SHORT_FOODS_ID=""
VITE_YOUTUBE_SHORT_SLEEP_ID=""
VITE_YOUTUBE_SHORT_GROUNDING_ID=""
VITE_YOUTUBE_SHORT_MOBILITY_ID=""
